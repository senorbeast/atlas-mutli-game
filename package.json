  "scripts": {
    "lint": "eslint app src --max-warnings=0",
    "lint:fix": "eslint app src --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"./src/**/*.{ts,tsx,md}\" \"./app/**/*.{ts,tsx,md}\"",
    "format": "prettier --write \"./src/**/*.{ts,tsx,md}\" \"./app/**/*.{ts,tsx,md}\"",
